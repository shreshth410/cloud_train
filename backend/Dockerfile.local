FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DEFAULT_TIMEOUT=120
RUN apt-get update && apt-get install -y --no-install-recommends docker-cli && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend /app/backend
COPY scripts/bootstrap_local.py /app/scripts/bootstrap_local.py
COPY shared /app/shared
RUN pip install ./backend "moto[server]==5.2.4"
CMD ["python", "backend/local_server.py"]

